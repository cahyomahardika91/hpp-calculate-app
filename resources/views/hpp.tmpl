        // Format currency helper
        function formatRupiah(amount) {
            if (isNaN(amount) || amount === null || amount === undefined) return "Rp 0";
            return "Rp " + Math.round(amount).toLocaleString('id-ID');
        }

        function formatDecimal(amount, decimals = 1) {
            if (isNaN(amount) || amount === null || amount === undefined) return "0";
            return Number(amount).toFixed(decimals);
        }

        // Tab Switching
        function switchTab(tab) {
            document.getElementById('sectionManufacture').classList.add('hidden');
            document.getElementById('sectionRetail').classList.add('hidden');
            document.getElementById('sectionGuide').classList.add('hidden');

            const tabManufacture = document.getElementById('tabBtnManufacture');
            const tabRetail = document.getElementById('tabBtnRetail');
            const tabGuide = document.getElementById('tabBtnGuide');

            const activeClass = ['bg-white', 'text-emerald-700', 'font-semibold', 'shadow-sm'];
            const inactiveClass = ['text-slate-600', 'hover:text-slate-900'];

            tabManufacture.classList.remove(...activeClass);
            tabRetail.classList.remove(...activeClass);
            tabGuide.classList.remove(...activeClass);
            tabManufacture.classList.add(...inactiveClass);
            tabRetail.classList.add(...inactiveClass);
            tabGuide.classList.add(...inactiveClass);

            if (tab === 'manufacture') {
                document.getElementById('sectionManufacture').classList.remove('hidden');
                tabManufacture.classList.add(...activeClass);
                tabManufacture.classList.remove(...inactiveClass);
                triggerCalculateManufacture();
            } else if (tab === 'retail') {
                document.getElementById('sectionRetail').classList.remove('hidden');
                tabRetail.classList.add(...activeClass);
                tabRetail.classList.remove(...inactiveClass);
                triggerCalculateRetail();
            } else if (tab === 'guide') {
                document.getElementById('sectionGuide').classList.remove('hidden');
                tabGuide.classList.add(...activeClass);
                tabGuide.classList.remove(...inactiveClass);
            }
        }

