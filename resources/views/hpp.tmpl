        // Calculation: Manufacture
        let calculateTimeout = null;
        function triggerCalculateManufacture() {
            clearTimeout(calculateTimeout);
            calculateTimeout = setTimeout(calculateManufacture, 150);
        }

        async function calculateManufacture() {
            const productName = document.getElementById('mProductName').value.trim() || "Produk Belum Dinamai";
            const units = parseFloat(document.getElementById('mProductionUnits').value) || 0;
            const markup = parseFloat(document.getElementById('mMarkupPercent').value) || 0;
            const pricingMethod = document.getElementById('mPricingMethod').value;

            // Update Formula Text and Examples
            const formulaNameElem = document.getElementById('mFormulaName');
            const formulaEqElem = document.getElementById('mFormulaEquation');
            const formulaExElem = document.getElementById('mFormulaExample');

            if (pricingMethod === 'margin_on_sales') {
                formulaNameElem.innerText = "Rumus: Margin on Sales (Persentase dari Harga Jual)";
                formulaEqElem.innerText = "Harga Jual = HPP per Unit \u00f7 (1 - (Target Margin% \u00f7 100))";
                formulaExElem.innerHTML = "  <strong>Contoh:</strong> Jika HPP Rp 10.000 dengan target margin 20%, maka Harga Jual = Rp 10.000 &divide; (1 - 0.20) = <strong>Rp 12.500</strong> (Laba Rp 2.500 adalah 20% dari Rp 12.500).";
            } else {
                formulaNameElem.innerText = "Rumus: Markup on Cost (Persentase dari Modal HPP)";
                formulaEqElem.innerText = "Harga Jual = HPP per Unit \u00d7 (1 + (Markup% \u00f7 100))";
                formulaExElem.innerHTML = "  <strong>Contoh:</strong> Jika HPP Rp 10.000 dengan Markup 50%, maka Harga Jual = Rp 10.000 &times; 1.50 = <strong>Rp 15.000</strong> (Laba Rp 5.000/unit).";
            }

            // Gather Raw Materials
            const rawMaterials = [];
            const rmRows = document.querySelectorAll('#rawMaterialsBody tr');
            let totalRM = 0;
            rmRows.forEach(row => {
                const name = row.querySelector('.rm-name')?.value || '';
                const qty = parseFloat(row.querySelector('.rm-qty')?.value) || 0;
                const unit = row.querySelector('.rm-unit')?.value || 'pcs';
                const price = parseThousand(row.querySelector('.rm-price')?.value);
                const subtotal = qty * price;
                totalRM += subtotal;
                const subElem = row.querySelector('.rm-subtotal');
                if (subElem) subElem.innerText = formatRupiah(subtotal);

                rawMaterials.push({ name, quantity: qty, unit, price_per_unit: price, subtotal });
            });
            document.getElementById('tableTotalRawMaterial').innerText = formatRupiah(totalRM);

            // Gather Labor
            const laborCosts = [];
            const lbRows = document.querySelectorAll('#laborBody tr');
            let totalLabor = 0;
            lbRows.forEach(row => {
                const role = row.querySelector('.lb-role')?.value || '';
                const workers = parseFloat(row.querySelector('.lb-workers')?.value) || 1;
                const rate = parseThousand(row.querySelector('.lb-rate')?.value);
                const hours = parseFloat(row.querySelector('.lb-hours')?.value) || 1;
                const subtotal = workers * rate * hours;
                totalLabor += subtotal;
                const subElem = row.querySelector('.lb-subtotal');
                if (subElem) subElem.innerText = formatRupiah(subtotal);

                laborCosts.push({ role, worker_count: workers, wage_rate: rate, hours_or_days: hours, subtotal });
            });
            document.getElementById('tableTotalLabor').innerText = formatRupiah(totalLabor);

            // Gather Overhead
            const overheadCosts = [];
            const ohRows = document.querySelectorAll('#overheadBody tr');
            let totalOverhead = 0;
            ohRows.forEach(row => {
                const name = row.querySelector('.oh-name')?.value || '';
                const category = row.querySelector('.oh-cat')?.value || 'Operasional';
                const cost = parseThousand(row.querySelector('.oh-cost')?.value);
                totalOverhead += cost;

                overheadCosts.push({ name, category, cost });
            });
            document.getElementById('tableTotalOverhead').innerText = formatRupiah(totalOverhead);

            // If production units is not set or 0, render 0 results cleanly
            if (units <= 0) {
                renderManufactureResult({
                    product_name: productName,
                    production_units: 0,
                    total_raw_material_cost: totalRM,
                    total_labor_cost: totalLabor,
                    total_overhead_cost: totalOverhead,
                    total_production_cost: totalRM + totalLabor + totalOverhead,
                    hpp_per_unit: 0,
                    pricing_method: pricingMethod,
                    markup_percent: markup,
                    selling_price_per_unit: 0,
                    profit_per_unit: 0,
                    total_revenue: 0,
                    total_profit: 0,
                    profit_margin_percent: 0,
                    raw_material_percentage: 0,
                    labor_percentage: 0,
                    overhead_percentage: 0,
                    break_even_units: 0,
                    break_even_revenue: 0,
                    calculated_at: new Date().toLocaleTimeString('id-ID')
                });
                return;
            }

            // Prepare API Payload
            const payload = {
                product_name: productName,
                production_units: units,
                markup_percent: markup,
                pricing_method: pricingMethod,
                raw_materials: rawMaterials,
                labor_costs: laborCosts,
                overhead_costs: overheadCosts
            };

            // Call Goravel API
            try {
                const response = await fetch('/api/hpp/calculate-manufacture', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (response.ok) {
                    const json = await response.json();
                    renderManufactureResult(json.data);
                    return;
                }
            } catch (e) {
                console.warn("API request failed, fallback to client calculation:", e);
            }

            // Fallback Client Calculation
            const totalProd = totalRM + totalLabor + totalOverhead;
            const hppPerUnit = totalProd / units;
            let sellingPrice = 0;
            if (pricingMethod === 'margin_on_sales') {
                const safeMarkup = markup >= 100 ? 99.9 : markup;
                sellingPrice = hppPerUnit / (1 - safeMarkup / 100);
            } else {
                sellingPrice = hppPerUnit * (1 + markup / 100);
            }
            const profitPerUnit = sellingPrice - hppPerUnit;
            const totalRevenue = sellingPrice * units;
            const totalProfit = profitPerUnit * units;
            const profitMargin = totalRevenue > 0 ? (totalProfit / totalRevenue) * 100 : 0;

            const varCostPerUnit = (totalRM + totalLabor) / units;
            const contribMargin = sellingPrice - varCostPerUnit;
            let bepUnits = 0;
            let bepRevenue = 0;
            if (contribMargin > 0 && totalOverhead > 0) {
                bepUnits = totalOverhead / contribMargin;
                bepRevenue = bepUnits * sellingPrice;
            }

            renderManufactureResult({
                product_name: productName,
                production_units: units,
                total_raw_material_cost: totalRM,
                total_labor_cost: totalLabor,
                total_overhead_cost: totalOverhead,
                total_production_cost: totalProd,
                hpp_per_unit: hppPerUnit,
                pricing_method: pricingMethod,
                markup_percent: markup,
                selling_price_per_unit: sellingPrice,
                profit_per_unit: profitPerUnit,
                total_revenue: totalRevenue,
                total_profit: totalProfit,
                profit_margin_percent: profitMargin,
                raw_material_percentage: totalProd > 0 ? (totalRM / totalProd) * 100 : 0,
                labor_percentage: totalProd > 0 ? (totalLabor / totalProd) * 100 : 0,
                overhead_percentage: totalProd > 0 ? (totalOverhead / totalProd) * 100 : 0,
                break_even_units: bepUnits,
                break_even_revenue: bepRevenue,
                calculated_at: new Date().toLocaleTimeString('id-ID')
            });
        }

        function renderManufactureResult(data) {
            document.getElementById('resProductName').innerText = data.product_name;
            document.getElementById('resHppPerUnit').innerText = formatRupiah(data.hpp_per_unit);
            document.getElementById('resSellingPrice').innerText = formatRupiah(data.selling_price_per_unit);
            document.getElementById('resProfitPerUnit').innerText = formatRupiah(data.profit_per_unit);
            document.getElementById('resMarkupBadge').innerText = (data.pricing_method === 'margin_on_sales' ? 'Margin ' : '+') + data.markup_percent + '%';
            document.getElementById('resTotalProductionCost').innerText = formatRupiah(data.total_production_cost);
            document.getElementById('resBatchUnits').innerText = (data.production_units || 0) + " Unit";
            document.getElementById('resTotalRevenue').innerText = formatRupiah(data.total_revenue);
            document.getElementById('resTotalProfit').innerText = formatRupiah(data.total_profit);
            document.getElementById('resMarginPercent').innerText = formatDecimal(data.profit_margin_percent, 1) + '%';
            document.getElementById('resBepUnits').innerText = Math.ceil(data.break_even_units || 0) + " Unit";
            document.getElementById('resBepRevenue').innerText = formatRupiah(data.break_even_revenue);

            // Progress Bars
            const rmPct = Math.round(data.raw_material_percentage || 0);
            const lbPct = Math.round(data.labor_percentage || 0);
            const ohPct = Math.round(data.overhead_percentage || 0);
            document.getElementById('barRawMaterial').style.width = rmPct + '%';
            document.getElementById('barLabor').style.width = lbPct + '%';
            document.getElementById('barOverhead').style.width = ohPct + '%';
            document.getElementById('pctRawMaterial').innerText = rmPct + '%';
            document.getElementById('pctLabor').innerText = lbPct + '%';
            document.getElementById('pctOverhead').innerText = ohPct + '%';

            // Summary Table
            document.getElementById('sumRawMaterial').innerText = formatRupiah(data.total_raw_material_cost);
            document.getElementById('sumLabor').innerText = formatRupiah(data.total_labor_cost);
            document.getElementById('sumOverhead').innerText = formatRupiah(data.total_overhead_cost);
            document.getElementById('sumTotalCost').innerText = formatRupiah(data.total_production_cost);

            if (data.calculated_at) {
                document.getElementById('resTimestamp').innerText = data.calculated_at;
            }
        }

        // Calculation: Retail
        let retailTimeout = null;
        function triggerCalculateRetail() {
            clearTimeout(retailTimeout);
            retailTimeout = setTimeout(calculateRetail, 150);
        }

        async function calculateRetail() {
            const periodName = document.getElementById('rPeriodName').value.trim() || "Periode Berjalan";
            const begInv = parseThousand(document.getElementById('rBeginningInventory').value);
            const purchases = parseThousand(document.getElementById('rPurchases').value);
            const freight = parseThousand(document.getElementById('rFreightIn').value);
            const pReturns = parseThousand(document.getElementById('rPurchaseReturns').value);
            const pDiscounts = parseThousand(document.getElementById('rPurchaseDiscounts').value);
            const endInv = parseThousand(document.getElementById('rEndingInventory').value);
            const sales = parseThousand(document.getElementById('rTotalSales').value);
            const sReturns = parseThousand(document.getElementById('rSalesReturns').value);
            const expenses = parseThousand(document.getElementById('rOperatingExpenses').value);

            const payload = {
                period_name: periodName,
                beginning_inventory: begInv,
                purchases: purchases,
                freight_in: freight,
                purchase_returns: pReturns,
                purchase_discounts: pDiscounts,
                ending_inventory: endInv,
                total_sales: sales,
                sales_returns: sReturns,
                operating_expenses: expenses
            };

            try {
                const response = await fetch('/api/hpp/calculate-retail', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (response.ok) {
                    const json = await response.json();
                    renderRetailResult(json.data);
                    return;
                }
            } catch (e) {
                console.warn("Retail API failed, fallback to client calculation:", e);
            }

            // Client-side fallback
            const netPurchases = purchases + freight - (pReturns + pDiscounts);
            const goodsAvail = begInv + netPurchases;
            const totalHpp = goodsAvail - endInv;
            const netSales = sales - sReturns;
            const grossProfit = netSales - totalHpp;
            const grossMargin = netSales > 0 ? (grossProfit / netSales) * 100 : 0;
            const netProfit = grossProfit - expenses;
            const netMargin = netSales > 0 ? (netProfit / netSales) * 100 : 0;

            renderRetailResult({
                period_name: periodName,
                beginning_inventory: begInv,
                gross_purchases: purchases,
                freight_in: freight,
                purchase_deductions: pReturns + pDiscounts,
                net_purchases: netPurchases,
                goods_available_for_sale: goodsAvail,
                ending_inventory: endInv,
                total_hpp: totalHpp,
                net_sales: netSales,
                gross_profit: grossProfit,
                gross_profit_margin_percent: grossMargin,
                operating_expenses: expenses,
                net_profit: netProfit,
                net_profit_margin_percent: netMargin,
                calculated_at: new Date().toLocaleTimeString('id-ID')
            });
        }

        function renderRetailResult(data) {
            document.getElementById('resRetailHpp').innerText = formatRupiah(data.total_hpp);
            document.getElementById('resRetailNetSales').innerText = formatRupiah(data.net_sales);
            document.getElementById('resRetailGoodsAvailable').innerText = formatRupiah(data.goods_available_for_sale);
            document.getElementById('resRetailGrossProfit').innerText = formatRupiah(data.gross_profit);
            document.getElementById('resRetailGrossMargin').innerText = `(${formatDecimal(data.gross_profit_margin_percent, 1)}% Margin)`;
            document.getElementById('resRetailExpenses').innerText = formatRupiah(data.operating_expenses);
            document.getElementById('resRetailNetProfit').innerText = formatRupiah(data.net_profit);
            document.getElementById('resRetailNetMargin').innerText = `Margin: ${formatDecimal(data.net_profit_margin_percent, 1)}%`;

            // Accounting Details
            document.getElementById('dtlBegInv').innerText = formatRupiah(data.beginning_inventory);
            document.getElementById('dtlNetPurchases').innerText = formatRupiah(data.net_purchases);
            document.getElementById('dtlGoodsAvail').innerText = formatRupiah(data.goods_available_for_sale);
            document.getElementById('dtlEndInv').innerText = formatRupiah(data.ending_inventory);
            document.getElementById('dtlTotalHpp').innerText = formatRupiah(data.total_hpp);

            if (data.calculated_at) {
                document.getElementById('retailResTimestamp').innerText = data.calculated_at;
            }
        }

        // Quick Preset Dropdown Handler
        function handlePresetSelect(key) {
            if (!key || key === "" || !presets[key]) {
                // If "-- Pilih Template Bisnis --" is selected, trigger reset form!
                resetCurrentForm();
                return;
            }
            loadPresetById(key);
        }

        // Load Preset By Key
        function loadPresetById(key) {
            if (!key || !presets[key]) {
                resetCurrentForm();
                return;
            }
            const p = presets[key];

            if (p.type === 'manufacture') {
                switchTab('manufacture');
                document.getElementById('mProductName').value = p.productName;
                document.getElementById('mProductionUnits').value = p.productionUnits;
                document.getElementById('mMarkupPercent').value = p.markupPercent;
                document.getElementById('mPricingMethod').value = p.pricingMethod;

                // Clear & re-populate rows with formatted prices
                document.getElementById('rawMaterialsBody').innerHTML = '';
                p.rawMaterials.forEach(rm => addRawMaterialRow(rm));

                document.getElementById('laborBody').innerHTML = '';
                p.laborCosts.forEach(lb => addLaborRow(lb));

                document.getElementById('overheadBody').innerHTML = '';
                p.overheadCosts.forEach(oh => addOverheadRow(oh));

                triggerCalculateManufacture();
            } else if (p.type === 'retail') {
                switchTab('retail');
                document.getElementById('rPeriodName').value = p.periodName;
                document.getElementById('rBeginningInventory').value = formatThousand(p.beginningInventory);
                document.getElementById('rPurchases').value = formatThousand(p.purchases);
                document.getElementById('rFreightIn').value = formatThousand(p.freightIn);
                document.getElementById('rPurchaseReturns').value = formatThousand(p.purchaseReturns);
                document.getElementById('rPurchaseDiscounts').value = formatThousand(p.purchaseDiscounts);
                document.getElementById('rEndingInventory').value = formatThousand(p.endingInventory);
                document.getElementById('rTotalSales').value = formatThousand(p.totalSales);
                document.getElementById('rSalesReturns').value = formatThousand(p.salesReturns);
                document.getElementById('rOperatingExpenses').value = formatThousand(p.operatingExpenses);

                triggerCalculateRetail();
            }
        }

        // Reset Current Active Form - Clears all textboxes to empty so placeholders are visible
        function resetCurrentForm() {
            // Also synchronize header dropdown to default
            const headerSelect = document.getElementById('headerPreset');
            if (headerSelect) headerSelect.value = "";

            if (!document.getElementById('sectionManufacture').classList.contains('hidden')) {
                document.getElementById('mProductName').value = '';
                document.getElementById('mProductionUnits').value = '';
                document.getElementById('mMarkupPercent').value = '';
                document.getElementById('mPricingMethod').value = 'markup_on_cost';

                document.getElementById('rawMaterialsBody').innerHTML = '';
                document.getElementById('laborBody').innerHTML = '';
                document.getElementById('overheadBody').innerHTML = '';

                // Add 1 empty row each with placeholders visible
                addRawMaterialRow();
                addLaborRow();
                addOverheadRow();

                triggerCalculateManufacture();
            } else if (!document.getElementById('sectionRetail').classList.contains('hidden')) {
                document.getElementById('rPeriodName').value = '';
                document.getElementById('rBeginningInventory').value = '';
                document.getElementById('rPurchases').value = '';
                document.getElementById('rFreightIn').value = '';
                document.getElementById('rPurchaseReturns').value = '';
                document.getElementById('rPurchaseDiscounts').value = '';
                document.getElementById('rEndingInventory').value = '';
                document.getElementById('rTotalSales').value = '';
                document.getElementById('rSalesReturns').value = '';
                document.getElementById('rOperatingExpenses').value = '';

                triggerCalculateRetail();
            }
        }

        // Copy Text Summary to Clipboard
        function copySummaryToClipboard() {
            let summaryText = "";
            const isManufacture = !document.getElementById('sectionManufacture').classList.contains('hidden');

            if (isManufacture) {
                const prod = document.getElementById('resProductName').innerText;
                const units = document.getElementById('resBatchUnits').innerText;
                const hpp = document.getElementById('resHppPerUnit').innerText;
                const price = document.getElementById('resSellingPrice').innerText;
                const profit = document.getElementById('resProfitPerUnit').innerText;
                const totalCost = document.getElementById('resTotalProductionCost').innerText;
                const totalRev = document.getElementById('resTotalRevenue').innerText;
                const totalProf = document.getElementById('resTotalProfit').innerText;
                const bepUnits = document.getElementById('resBepUnits').innerText;

                summaryText = `RINGKASAN HPP MANUFAKTUR & PRODUKSI
Produk: ${prod}
Batch Output: ${units}
Total Biaya Modal: ${totalCost}

HPP per Unit: ${hpp}
Rekomendasi Harga Jual: ${price}
Laba per Unit: ${profit}

Proyeksi Keuangan:
- Potensi Total Omset: ${totalRev}
- Potensi Total Laba: ${totalProf}
- BEP (Titik Impas): ${bepUnits}

Dihitung via Kalkulator HPP`;
            } else {
                const period = document.getElementById('rPeriodName').value || "Periode Berjalan";
                const hpp = document.getElementById('resRetailHpp').innerText;
                const sales = document.getElementById('resRetailNetSales').innerText;
                const gross = document.getElementById('resRetailGrossProfit').innerText;
                const net = document.getElementById('resRetailNetProfit').innerText;

                summaryText = `RINGKASAN HPP USAHA DAGANG / RETAIL
Periode: ${period}
Total HPP: ${hpp}
Penjualan Bersih: ${sales}
Laba Kotor: ${gross}
Laba Bersih Toko: ${net}

Dihitung via Kalkulator HPP`;
            }

            navigator.clipboard.writeText(summaryText).then(() => {
                alert("Ringkasan berhasil disalin ke clipboard!");
            }).catch(() => {
                alert("Gagal menyalin ringkasan.");
            });
        }

        // Initialize on Load
        window.addEventListener('DOMContentLoaded', () => {
            const dateStr = new Date().toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
            const printDate = document.getElementById('printDate');
            if (printDate) printDate.innerText = `Dicetak pada: ${dateStr}`;

            // Initialize with empty clean form displaying placeholders
            resetCurrentForm();
        });
    </script>
</body>
</html>
