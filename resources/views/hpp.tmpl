<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kalkulator HPP</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        @media print {
            .no-print { display: none !important; }
            .print-only { display: block !important; }
            body { background: white !important; color: black !important; }
            .card-print { border: 1px solid #e2e8f0; box-shadow: none !important; }
        }
        .print-only { display: none; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col antialiased">

    <!-- Top Navigation / Header -->
    <header class="bg-gradient-to-r from-emerald-700 via-teal-700 to-cyan-800 text-white shadow-lg sticky top-0 z-30 no-print">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div>
                    <h1 class="text-lg font-bold tracking-tight leading-none flex items-center gap-2">
                        Kalkulator HPP Indonesia                        
                    </h1>
                    <p class="text-xs text-emerald-100/80 mt-0.5">Perhitungan Harga Pokok Penjualan, Margin Keuntungan & Titik Impas (BEP)</p>
                </div>
            </div>

            <!-- Quick Preset Selector in Header -->
            <div class="flex items-center space-x-2">
                <label for="headerPreset" class="text-xs text-emerald-100 hidden md:inline font-medium">Contoh Cepat:</label>
                <select id="headerPreset" onchange="handlePresetSelect(this.value)" class="text-xs bg-emerald-800/80 hover:bg-emerald-800 text-white border border-emerald-500/50 rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-emerald-400 cursor-pointer">
                    <option value="">-- Pilih Template Bisnis --</option>
                    <option value="kopi-susu-aren">Es Kopi Susu (Kuliner)</option>
                    <option value="kaos-sablon-distro">Kaos Sablon Distro (Konveksi)</option>
                    <option value="fudgy-brownies">Fudgy Brownies (Bakery)</option>
                    <option value="retail-sembako">Toko Sembako (Retail/Dagang)</option>
                </select>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- Nav Tabs (Modes) -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6 no-print">
            <div class="inline-flex p-1 bg-slate-200/80 rounded-xl shadow-inner text-sm font-medium">
                <button id="tabBtnManufacture" onclick="switchTab('manufacture')" class="flex items-center gap-2 px-4 py-2 rounded-lg transition-all duration-200 bg-white text-emerald-700 font-semibold shadow-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                    HPP Manufaktur & Kuliner / UMKM
                </button>
                <button id="tabBtnRetail" onclick="switchTab('retail')" class="flex items-center gap-2 px-4 py-2 rounded-lg transition-all duration-200 text-slate-600 hover:text-slate-900">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                    HPP Usaha Dagang & Retail
                </button>
                <button id="tabBtnGuide" onclick="switchTab('guide')" class="flex items-center gap-2 px-4 py-2 rounded-lg transition-all duration-200 text-slate-600 hover:text-slate-900">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    Panduan & Rumus
                </button>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center gap-2">
                <button onclick="window.print()" class="px-3 py-2 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold rounded-lg border border-slate-300 shadow-sm flex items-center gap-1.5 transition">
                    <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
                    Cetak / Simpan PDF
                </button>
                <button onclick="copySummaryToClipboard()" class="px-3 py-2 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold rounded-lg border border-slate-300 shadow-sm flex items-center gap-1.5 transition">
                    <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                    Salin Ringkasan
                </button>
                <button onclick="resetCurrentForm()" class="px-3 py-2 bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-semibold rounded-lg border border-rose-200 shadow-sm transition flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                    Reset Form
                </button>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB 1: MANUFACTURE & CULINARY HPP          -->
        <!-- ========================================== -->
        <div id="sectionManufacture" class="space-y-6">
            <!-- Grid 2 Columns: Form Input Left, Summary Dashboard Right -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

                <!-- Left Column: Inputs (7 cols) -->
                <div class="lg:col-span-7 space-y-6">

                    <!-- Basic Product Info Card -->
                    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm space-y-4">
                        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                            <div>
                                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                                    <span class="w-6 h-6 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center text-xs font-bold">1</span>
                                    Informasi Produk & Target Batch
                                </h2>
                                <p class="text-xs text-slate-500 mt-0.5">Tentukan nama produk, target unit hasil produksi, dan strategi penetapan harga.</p>
                            </div>
                            <span class="text-[11px] font-mono bg-emerald-50 text-emerald-700 border border-emerald-200 px-2 py-0.5 rounded-full">
                                HPP = Total Biaya &divide; Unit
                            </span>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Produk / Menu</label>
                                <input type="text" id="mProductName" value="" placeholder="Contoh: Es Kopi Susu Aren, Kaos Sablon, Roti Brownies" class="w-full text-sm px-3 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition">
                                <p class="text-[11px] text-slate-400 mt-1">Nama barang atau menu makanan yang diproduksi</p>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">
                                    Jumlah Unit yang Dihasilkan (Batch Output)
                                </label>
                                <div class="relative">
                                    <input type="number" id="mProductionUnits" value="" min="1" step="any" placeholder="Contoh: 100" oninput="triggerCalculateManufacture()" class="w-full text-sm px-3 py-2 pr-12 rounded-lg border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition font-medium">
                                    <span class="absolute right-3 top-2 text-xs font-medium text-slate-400">Unit/Pcs</span>
                                </div>
                                <p class="text-[11px] text-slate-400 mt-1">Contoh: 1 resep bahan menghasilkan 100 cup atau 20 loyang</p>
                            </div>
                        </div>

                        <!-- Pricing Strategy Settings with Formulas -->
                        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200/70 space-y-3">
                            <div class="text-xs font-bold text-slate-700 flex items-center gap-1.5">
                                <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                                Strategi Penetapan Harga Jual (Pricing Formula)
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs font-semibold text-slate-700 mb-1">Metode Penetapan Harga</label>
                                    <select id="mPricingMethod" onchange="triggerCalculateManufacture()" class="w-full text-xs font-medium px-3 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-emerald-500 bg-white cursor-pointer">
                                        <option value="markup_on_cost">Markup on Cost (Dari Modal HPP)</option>
                                        <option value="margin_on_sales">Margin on Sales (Dari Harga Jual)</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-semibold text-slate-700 mb-1">Target Persentase Laba (%)</label>
                                    <div class="relative">
                                        <input type="number" id="mMarkupPercent" value="" min="0" max="999" step="any" placeholder="Contoh: 50" oninput="triggerCalculateManufacture()" class="w-full text-sm px-3 py-2 pr-8 rounded-lg border border-slate-300 focus:ring-2 focus:ring-emerald-500 outline-none transition font-semibold text-emerald-800">
                                        <span class="absolute right-3 top-2 text-xs font-bold text-slate-400">%</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Live Dynamic Formula & Example Explanation -->
                            <div class="p-3 bg-white rounded-lg border border-slate-200 text-xs space-y-1.5" id="pricingFormulaBox">
                                <div class="flex items-center gap-1.5 text-emerald-800 font-semibold">
                                    <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                    <span id="mFormulaName">Rumus: Markup on Cost</span>
                                </div>
                                <div class="font-mono text-[11px] text-slate-700 bg-slate-50 p-2 rounded border border-slate-100" id="mFormulaEquation">
                                    Harga Jual = HPP per Unit &times; (1 + (Markup% &divide; 100))
                                </div>
                                <div class="text-[11px] text-slate-500" id="mFormulaExample">
                                      <strong>Contoh:</strong> Jika HPP Rp 10.000 dengan Markup 50%, maka Harga Jual = Rp 10.000 &times; 1.50 = <strong>Rp 15.000</strong> (Laba: Rp 5.000/unit).
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Raw Materials Table -->
                    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm space-y-4">
                        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                            <div>
                                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                                    <span class="w-6 h-6 rounded-lg bg-teal-100 text-teal-700 flex items-center justify-center text-xs font-bold">2</span>
                                    Biaya Bahan Baku (Raw Materials)
                                </h2>
                                <p class="text-xs text-slate-500 mt-0.5">Semua bahan utama dan bahan pembantu yang habis terpakai dalam 1 batch.</p>
                            </div>
                            <button onclick="addRawMaterialRow()" class="px-2.5 py-1.5 bg-teal-50 hover:bg-teal-100 text-teal-700 font-semibold text-xs rounded-lg border border-teal-200 transition flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                                Tambah Bahan
                            </button>
                        </div>

                        <!-- Formula Banner -->
                        <div class="flex items-center justify-between px-3 py-2 bg-teal-50/60 rounded-lg border border-teal-100 text-[11px] text-teal-900">
                            <span><strong>Rumus:</strong> Subtotal = Kuantitas &times; Harga Satuan</span>
                            <span class="text-teal-700 hidden sm:inline">Contoh: 1.2 kg &times; Rp 180.000 = Rp 216.000</span>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs">
                                <thead>
                                    <tr class="text-slate-500 border-b border-slate-200">
                                        <th class="pb-2 font-semibold">Nama Bahan Baku</th>
                                        <th class="pb-2 font-semibold w-20">Kuantitas</th>
                                        <th class="pb-2 font-semibold w-20">Satuan</th>
                                        <th class="pb-2 font-semibold w-36">Harga Satuan (Rp)</th>
                                        <th class="pb-2 font-semibold w-32 text-right">Subtotal (Rp)</th>
                                        <th class="pb-2 w-8"></th>
                                    </tr>
                                </thead>
                                <tbody id="rawMaterialsBody" class="divide-y divide-slate-100">
                                    <!-- Dynamic Rows -->
                                </tbody>
                                <tfoot>
                                    <tr class="font-bold text-slate-700 border-t border-slate-200">
                                        <td colspan="4" class="pt-3 text-right">Total Biaya Bahan Baku:</td>
                                        <td class="pt-3 text-right text-teal-700 text-sm" id="tableTotalRawMaterial">Rp 0</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <!-- 3. Direct Labor Table -->
                    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm space-y-4">
                        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                            <div>
                                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                                    <span class="w-6 h-6 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center text-xs font-bold">3</span>
                                    Biaya Tenaga Kerja Langsung (Direct Labor)
                                </h2>
                                <p class="text-xs text-slate-500 mt-0.5">Upah tenaga kerja yang langsung terlibat dalam pembuatan produk (per jam/hari/pcs).</p>
                            </div>
                            <button onclick="addLaborRow()" class="px-2.5 py-1.5 bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold text-xs rounded-lg border border-blue-200 transition flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                                Tambah Pekerja
                            </button>
                        </div>

                        <!-- Formula Banner -->
                        <div class="flex items-center justify-between px-3 py-2 bg-blue-50/60 rounded-lg border border-blue-100 text-[11px] text-blue-900">
                            <span><strong>Rumus:</strong> Subtotal = Jumlah Pekerja &times; Tarif Upah &times; Waktu/Unit</span>
                            <span class="text-blue-700 hidden sm:inline">Contoh: 1 Barista &times; Rp 20.000 &times; 4 jam = Rp 80.000</span>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs">
                                <thead>
                                    <tr class="text-slate-500 border-b border-slate-200">
                                        <th class="pb-2 font-semibold">Peran / Posisi Kerja</th>
                                        <th class="pb-2 font-semibold w-16">Pekerja</th>
                                        <th class="pb-2 font-semibold w-32">Tarif Upah (Rp)</th>
                                        <th class="pb-2 font-semibold w-20">Jam/Hari/Pcs</th>
                                        <th class="pb-2 font-semibold w-32 text-right">Subtotal (Rp)</th>
                                        <th class="pb-2 w-8"></th>
                                    </tr>
                                </thead>
                                <tbody id="laborBody" class="divide-y divide-slate-100">
                                    <!-- Dynamic Rows -->
                                </tbody>
                                <tfoot>
                                    <tr class="font-bold text-slate-700 border-t border-slate-200">
                                        <td colspan="4" class="pt-3 text-right">Total Biaya Tenaga Kerja:</td>
                                        <td class="pt-3 text-right text-blue-700 text-sm" id="tableTotalLabor">Rp 0</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <!-- 4. Overhead Costs Table -->
                    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm space-y-4">
                        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                            <div>
                                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                                    <span class="w-6 h-6 rounded-lg bg-purple-100 text-purple-700 flex items-center justify-center text-xs font-bold">4</span>
                                    Biaya Overhead Pabrik / Usaha (BOP)
                                </h2>
                                <p class="text-xs text-slate-500 mt-0.5">Biaya tidak langsung: listrik, gas LPG, sewa proporsional, penyusutan alat, perlengkapan.</p>
                            </div>
                            <button onclick="addOverheadRow()" class="px-2.5 py-1.5 bg-purple-50 hover:bg-purple-100 text-purple-700 font-semibold text-xs rounded-lg border border-purple-200 transition flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                                Tambah Overhead
                            </button>
                        </div>

                        <!-- Formula Banner -->
                        <div class="flex items-center justify-between px-3 py-2 bg-purple-50/60 rounded-lg border border-purple-100 text-[11px] text-purple-900">
                            <span><strong>Rumus:</strong> Total BOP = &sum; Biaya Listrik + Gas + Sewa + Penyusutan Alat</span>
                            <span class="text-purple-700 hidden sm:inline">Contoh: Listrik Rp 30.000 + Sewa Rp 45.000</span>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs">
                                <thead>
                                    <tr class="text-slate-500 border-b border-slate-200">
                                        <th class="pb-2 font-semibold">Nama Biaya Overhead</th>
                                        <th class="pb-2 font-semibold w-36">Kategori</th>
                                        <th class="pb-2 font-semibold w-36 text-right">Nominal Biaya (Rp)</th>
                                        <th class="pb-2 w-8"></th>
                                    </tr>
                                </thead>
                                <tbody id="overheadBody" class="divide-y divide-slate-100">
                                    <!-- Dynamic Rows -->
                                </tbody>
                                <tfoot>
                                    <tr class="font-bold text-slate-700 border-t border-slate-200">
                                        <td colspan="2" class="pt-3 text-right">Total Biaya Overhead:</td>
                                        <td class="pt-3 text-right text-purple-700 text-sm" id="tableTotalOverhead">Rp 0</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Results Dashboard (5 cols) -->
                <div class="lg:col-span-5 space-y-6">

                    <!-- Main HPP Result Card -->
                    <div class="bg-gradient-to-br from-slate-700 to-slate-900 text-white rounded-2xl p-6 shadow-xl relative overflow-hidden border border-slate-700">
                        <div class="absolute -right-6 -bottom-6 w-36 h-36 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none"></div>

                        <div class="flex items-center justify-between mb-4">
                            <span class="text-xs uppercase tracking-wider font-semibold text-emerald-400 bg-emerald-950/80 px-2.5 py-1 rounded-md border border-emerald-800">
                                Ringkasan HPP Manufaktur & UMKM
                            </span>
                           <!-- <span id="resTimestamp" class="text-[11px] text-slate-400">Hari ini</span> -->
                        </div>

                        <h3 id="resProductName" class="text-lg font-bold text-white mb-4 line-clamp-1">Produk Belum Dinamai</h3>

                        <!-- HPP per Unit Highlight with Formula Badge -->
                        <div class="bg-slate-800/80 rounded-xl p-4 border border-slate-700/80 mb-4">
                            <div class="flex items-center justify-between">
                                <span class="text-xs text-slate-400 font-medium">HARGA POKOK PENJUALAN (HPP) PER UNIT</span>
                                <span class="text-[10px] text-emerald-300 font-mono bg-slate-700/80 px-1.5 py-0.5 rounded">Total Biaya &divide; Unit</span>
                            </div>
                            <div class="text-3xl font-extrabold text-emerald-400 tracking-tight mt-1" id="resHppPerUnit">Rp 0</div>
                            <div class="text-xs text-slate-400 mt-1">Modal bersih yang dikeluarkan untuk memproduksi 1 unit</div>
                        </div>

                        <!-- Selling Price Highlight with Formula Badge -->
                        <div class="bg-emerald-950/60 rounded-xl p-4 border border-emerald-600/50 mb-5">
                            <div class="flex items-center justify-between">
                                <span class="text-xs text-emerald-300 font-medium">REKOMENDASI HARGA JUAL</span>
                                <span id="resMarkupBadge" class="text-[10px] font-bold bg-emerald-500 text-slate-950 px-2 py-0.5 rounded-full">+0% Markup</span>
                            </div>
                            <div class="text-3xl font-extrabold text-white tracking-tight mt-1" id="resSellingPrice">Rp 0</div>
                            <div class="flex items-center justify-between text-xs text-emerald-200/80 mt-1">
                                <span>Laba per unit: (Harga Jual - HPP)</span>
                                <span class="font-bold text-emerald-300" id="resProfitPerUnit">Rp 0</span>
                            </div>
                        </div>

                        <!-- Cost Structure Progress Bar -->
                        <div class="space-y-2 mb-5">
                            <div class="flex justify-between text-xs font-medium">
