        // Load Preset By Key
        function loadPresetById(key) {
            if (!key || !presets[key]) return;
            const p = presets[key];

            if (p.type === 'manufacture') {
                switchTab('manufacture');
                document.getElementById('mProductName').value = p.productName;
                document.getElementById('mProductionUnits').value = p.productionUnits;
                document.getElementById('mMarkupPercent').value = p.markupPercent;
                document.getElementById('mPricingMethod').value = p.pricingMethod;

                // Clear & re-populate rows
                document.getElementById('rawMaterialsBody').innerHTML = '';
                p.rawMaterials.forEach(rm => addRawMaterialRow(rm));

                document.getElementById('laborBody').innerHTML = '';
                p.laborCosts.forEach(lb => addLaborRow(lb));

                document.getElementById('overheadBody').innerHTML = '';
                p.overheadCosts.forEach(oh => addOverheadRow(oh));

                triggerCalculateManufacture();
            } else if (p.type === 'retail') {
                switchTab('retail');
                document.getElementById('rPeriodName').value = p.periodName;
                document.getElementById('rBeginningInventory').value = p.beginningInventory;
                document.getElementById('rPurchases').value = p.purchases;
                document.getElementById('rFreightIn').value = p.freightIn;
                document.getElementById('rPurchaseReturns').value = p.purchaseReturns;
                document.getElementById('rPurchaseDiscounts').value = p.purchaseDiscounts;
                document.getElementById('rEndingInventory').value = p.endingInventory;
                document.getElementById('rTotalSales').value = p.totalSales;
                document.getElementById('rSalesReturns').value = p.salesReturns;
                document.getElementById('rOperatingExpenses').value = p.operatingExpenses;

                triggerCalculateRetail();
            }
        }

