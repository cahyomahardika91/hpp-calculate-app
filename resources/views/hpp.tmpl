<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kalkulator HPP - Goravel Go Framework</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        }
        @media print {
            .no-print { display: none !important; }
            .print-only { display: block !important; }
            body { background: white !important; color: black !important; }
            .card-print { border: 1px solid #e2e8f0; box-shadow: none !important; }
        }
        .print-only { display: none; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col antialiased">

    <!-- Top Navigation / Header -->
    <header class="bg-gradient-to-r from-emerald-700 via-teal-700 to-cyan-800 text-white shadow-lg sticky top-0 z-30 no-print">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-white/10 backdrop-blur border border-white/20 flex items-center justify-center font-bold text-xl text-emerald-300 shadow-inner">
                    H
                </div>
                <div>
                    <h1 class="text-lg font-bold tracking-tight leading-none flex items-center gap-2">
                        Kalkulator HPP Indonesia
                        <span class="text-[10px] uppercase font-semibold bg-emerald-500/30 text-emerald-200 px-2 py-0.5 rounded-full border border-emerald-400/30">
                            Goravel {{ .version }}
                        </span>
                    </h1>
                    <p class="text-xs text-emerald-100/80 mt-0.5">Aplikasi Perhitungan Harga Pokok Penjualan & Penetapan Harga Jual</p>
                </div>
            </div>

            <!-- Quick Preset Selector in Header -->
            <div class="flex items-center space-x-2">
                <label for="headerPreset" class="text-xs text-emerald-100 hidden md:inline">Contoh Cepat:</label>
                <select id="headerPreset" onchange="loadPresetById(this.value)" class="text-xs bg-emerald-800/80 hover:bg-emerald-800 text-white border border-emerald-500/50 rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-emerald-400 cursor-pointer">
                    <option value="">-- Pilih Template Bisnis --</option>
                    <option value="kopi-susu-aren">☕ Es Kopi Susu (Kuliner)</option>
                    <option value="kaos-sablon-distro">👕 Kaos Sablon Distro (Konveksi)</option>
                    <option value="fudgy-brownies">🍰 Fudgy Brownies (Bakery)</option>
                    <option value="retail-sembako">🏪 Toko Sembako (Retail/Dagang)</option>
                </select>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">

        <!-- Nav Tabs (Modes) -->
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6 no-print">
            <div class="inline-flex p-1 bg-slate-200/80 rounded-xl shadow-inner text-sm font-medium">
                <button id="tabBtnManufacture" onclick="switchTab('manufacture')" class="flex items-center gap-2 px-4 py-2 rounded-lg transition-all duration-200 bg-white text-emerald-700 font-semibold shadow-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
                    HPP Manufaktur & Kuliner / UMKM
                </button>
                <button id="tabBtnRetail" onclick="switchTab('retail')" class="flex items-center gap-2 px-4 py-2 rounded-lg transition-all duration-200 text-slate-600 hover:text-slate-900">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
                    HPP Usaha Dagang & Retail
                </button>
                <button id="tabBtnGuide" onclick="switchTab('guide')" class="flex items-center gap-2 px-4 py-2 rounded-lg transition-all duration-200 text-slate-600 hover:text-slate-900">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    Panduan & Rumus
                </button>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center gap-2">
                <button onclick="window.print()" class="px-3 py-2 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold rounded-lg border border-slate-300 shadow-sm flex items-center gap-1.5 transition">
                    <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
                    Cetak / Simpan PDF
                </button>
                <button onclick="copySummaryToClipboard()" class="px-3 py-2 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold rounded-lg border border-slate-300 shadow-sm flex items-center gap-1.5 transition">
                    <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                    Salin Ringkasan
                </button>
                <button onclick="resetCurrentForm()" class="px-3 py-2 bg-rose-50 hover:bg-rose-100 text-rose-700 text-xs font-semibold rounded-lg border border-rose-200 shadow-sm transition">
                    Reset Form
                </button>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB 1: MANUFACTURE & CULINARY HPP          -->
        <!-- ========================================== -->
        <div id="sectionManufacture" class="space-y-6">
            <!-- Grid 2 Columns: Form Input Left, Summary Dashboard Right -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

                <!-- Left Column: Inputs (7 cols) -->
                <div class="lg:col-span-7 space-y-6">

                    <!-- Basic Product Info Card -->
                    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm space-y-4">
                        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                            <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                                <span class="w-6 h-6 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center text-xs font-bold">1</span>
                                Informasi Produk & Target Batch
                            </h2>
                            <span class="text-xs text-slate-400">Parameter Dasar</span>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Produk / Menu</label>
                                <input type="text" id="mProductName" value="Es Kopi Susu Gula Aren (16oz)" placeholder="Contoh: Es Kopi Susu, Kaos Sablon, Roti" class="w-full text-sm px-3 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">Jumlah Unit yang Dihasilkan (Batch Output)</label>
                                <div class="relative">
                                    <input type="number" id="mProductionUnits" value="100" min="1" step="any" oninput="triggerCalculateManufacture()" class="w-full text-sm px-3 py-2 pr-12 rounded-lg border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition">
                                    <span class="absolute right-3 top-2 text-xs text-slate-400">Unit/Pcs</span>
                                </div>
                            </div>
                        </div>

                        <!-- Pricing Strategy Settings -->
                        <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200/70 grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">Metode Penetapan Harga Jual</label>
                                <select id="mPricingMethod" onchange="triggerCalculateManufacture()" class="w-full text-xs font-medium px-3 py-2 rounded-lg border border-slate-300 focus:ring-2 focus:ring-emerald-500 bg-white">
                                    <option value="markup_on_cost">Markup on Cost (Dari Biaya HPP)</option>
                                    <option value="margin_on_sales">Margin on Sales (Dari Harga Jual)</option>
                                </select>
                                <p class="text-[11px] text-slate-400 mt-1" id="mPricingMethodHint">Markup on Cost: Harga = HPP + (HPP × %)</p>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-700 mb-1">Target Persentase Laba (%)</label>
                                <div class="relative">
                                    <input type="number" id="mMarkupPercent" value="60" min="0" max="999" step="any" oninput="triggerCalculateManufacture()" class="w-full text-sm px-3 py-2 pr-8 rounded-lg border border-slate-300 focus:ring-2 focus:ring-emerald-500 outline-none transition font-semibold text-emerald-800">
                                    <span class="absolute right-3 top-2 text-xs font-bold text-slate-400">%</span>
                                </div>
                                <p class="text-[11px] text-slate-400 mt-1">Keuntungan per unit yang diharapkan</p>
                            </div>
                        </div>
                    </div>

                    <!-- 1. Raw Materials Table -->
                    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm space-y-4">
                        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                            <div>
                                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                                    <span class="w-6 h-6 rounded-lg bg-teal-100 text-teal-700 flex items-center justify-center text-xs font-bold">2</span>
                                    Biaya Bahan Baku (Raw Materials)
                                </h2>
                                <p class="text-xs text-slate-400 mt-0.5">Semua bahan utama dan pembantu untuk membuat produk</p>
                            </div>
                            <button onclick="addRawMaterialRow()" class="px-2.5 py-1.5 bg-teal-50 hover:bg-teal-100 text-teal-700 font-semibold text-xs rounded-lg border border-teal-200 transition flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                                Tambah Bahan
                            </button>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs">
                                <thead>
                                    <tr class="text-slate-500 border-b border-slate-200">
                                        <th class="pb-2 font-semibold">Nama Bahan</th>
                                        <th class="pb-2 font-semibold w-20">Kuantitas</th>
                                        <th class="pb-2 font-semibold w-16">Satuan</th>
                                        <th class="pb-2 font-semibold w-28">Harga Satuan (Rp)</th>
                                        <th class="pb-2 font-semibold w-28 text-right">Subtotal (Rp)</th>
                                        <th class="pb-2 w-8"></th>
                                    </tr>
                                </thead>
                                <tbody id="rawMaterialsBody" class="divide-y divide-slate-100">
                                    <!-- Dynamic Rows -->
                                </tbody>
                                <tfoot>
                                    <tr class="font-bold text-slate-700 border-t border-slate-200">
                                        <td colspan="4" class="pt-3 text-right">Total Biaya Bahan Baku:</td>
                                        <td class="pt-3 text-right text-teal-700 text-sm" id="tableTotalRawMaterial">Rp 0</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <!-- 2. Direct Labor Table -->
                    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm space-y-4">
                        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                            <div>
                                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                                    <span class="w-6 h-6 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center text-xs font-bold">3</span>
                                    Biaya Tenaga Kerja Langsung (Direct Labor)
                                </h2>
                                <p class="text-xs text-slate-400 mt-0.5">Upah pekerja langsung dalam proses produksi</p>
                            </div>
                            <button onclick="addLaborRow()" class="px-2.5 py-1.5 bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold text-xs rounded-lg border border-blue-200 transition flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                                Tambah Tenaga Kerja
                            </button>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs">
                                <thead>
                                    <tr class="text-slate-500 border-b border-slate-200">
                                        <th class="pb-2 font-semibold">Peran / Karyawan</th>
                                        <th class="pb-2 font-semibold w-16">Pekerja</th>
                                        <th class="pb-2 font-semibold w-24">Tarif (Rp)</th>
                                        <th class="pb-2 font-semibold w-20">Jam/Hari/Pcs</th>
                                        <th class="pb-2 font-semibold w-28 text-right">Subtotal (Rp)</th>
                                        <th class="pb-2 w-8"></th>
                                    </tr>
                                </thead>
                                <tbody id="laborBody" class="divide-y divide-slate-100">
                                    <!-- Dynamic Rows -->
                                </tbody>
                                <tfoot>
                                    <tr class="font-bold text-slate-700 border-t border-slate-200">
                                        <td colspan="4" class="pt-3 text-right">Total Biaya Tenaga Kerja:</td>
                                        <td class="pt-3 text-right text-blue-700 text-sm" id="tableTotalLabor">Rp 0</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>

                    <!-- 3. Overhead Costs Table -->
                    <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm space-y-4">
                        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                            <div>
                                <h2 class="text-base font-bold text-slate-800 flex items-center gap-2">
                                    <span class="w-6 h-6 rounded-lg bg-purple-100 text-purple-700 flex items-center justify-center text-xs font-bold">4</span>
                                    Biaya Overhead Pabrik / Operasional (BOP)
                                </h2>
                                <p class="text-xs text-slate-400 mt-0.5">Biaya listrik, gas, packaging, sewa proporsional, penyusutan alat</p>
                            </div>
                            <button onclick="addOverheadRow()" class="px-2.5 py-1.5 bg-purple-50 hover:bg-purple-100 text-purple-700 font-semibold text-xs rounded-lg border border-purple-200 transition flex items-center gap-1">
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                                Tambah Overhead
                            </button>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="w-full text-left text-xs">
                                <thead>
                                    <tr class="text-slate-500 border-b border-slate-200">
                                        <th class="pb-2 font-semibold">Nama Biaya Overhead</th>
                                        <th class="pb-2 font-semibold w-36">Kategori</th>
                                        <th class="pb-2 font-semibold w-32 text-right">Nominal Biaya (Rp)</th>
                                        <th class="pb-2 w-8"></th>
                                    </tr>
                                </thead>
                                <tbody id="overheadBody" class="divide-y divide-slate-100">
                                    <!-- Dynamic Rows -->
                                </tbody>
                                <tfoot>
                                    <tr class="font-bold text-slate-700 border-t border-slate-200">
                                        <td colspan="2" class="pt-3 text-right">Total Biaya Overhead:</td>
                                        <td class="pt-3 text-right text-purple-700 text-sm" id="tableTotalOverhead">Rp 0</td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Results Dashboard (5 cols) -->
                <div class="lg:col-span-5 space-y-6">

                    <!-- Main HPP Result Card -->
                    <div class="bg-gradient-to-br from-slate-900 to-slate-800 text-white rounded-2xl p-6 shadow-xl relative overflow-hidden border border-slate-700">
                        <div class="absolute -right-6 -bottom-6 w-36 h-36 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none"></div>

                        <div class="flex items-center justify-between mb-4">
                            <span class="text-xs uppercase tracking-wider font-semibold text-emerald-400 bg-emerald-950/80 px-2.5 py-1 rounded-md border border-emerald-800">
                                Hasil Perhitungan HPP
                            </span>
                            <span id="resTimestamp" class="text-[11px] text-slate-400">Hari ini</span>
                        </div>

                        <h3 id="resProductName" class="text-lg font-bold text-white mb-4 line-clamp-1">Es Kopi Susu Gula Aren (16oz)</h3>

                        <!-- HPP per Unit Highlight -->
                        <div class="bg-slate-800/80 rounded-xl p-4 border border-slate-700/80 mb-4">
                            <div class="text-xs text-slate-400 font-medium mb-1">HARGA POKOK PENJUALAN (HPP) PER UNIT</div>
                            <div class="text-3xl font-extrabold text-emerald-400 tracking-tight" id="resHppPerUnit">Rp 0</div>
                            <div class="text-xs text-slate-400 mt-1">Biaya murni modal produksi per 1 item</div>
                        </div>

                        <!-- Selling Price Highlight -->
                        <div class="bg-emerald-950/60 rounded-xl p-4 border border-emerald-600/50 mb-5">
                            <div class="flex items-center justify-between">
                                <span class="text-xs text-emerald-300 font-medium">REKOMENDASI HARGA JUAL</span>
                                <span id="resMarkupBadge" class="text-[10px] font-bold bg-emerald-500 text-slate-950 px-2 py-0.5 rounded-full">+60% Markup</span>
                            </div>
                            <div class="text-3xl font-extrabold text-white tracking-tight mt-1" id="resSellingPrice">Rp 0</div>
                            <div class="flex items-center justify-between text-xs text-emerald-200/80 mt-1">
                                <span>Laba per unit:</span>
                                <span class="font-bold text-emerald-300" id="resProfitPerUnit">Rp 0</span>
                            </div>
                        </div>

                        <!-- Cost Structure Progress Bar -->
                        <div class="space-y-2 mb-5">
                            <div class="flex justify-between text-xs font-medium">
                                <span class="text-slate-300">Struktur Komponen Biaya</span>
                                <span class="text-slate-400 text-[11px]">Total: <strong class="text-white" id="resTotalProductionCost">Rp 0</strong></span>
                            </div>
                            <div class="h-3 w-full bg-slate-700 rounded-full overflow-hidden flex">
                                <div id="barRawMaterial" class="bg-teal-400 transition-all duration-300" style="width: 50%" title="Bahan Baku"></div>
                                <div id="barLabor" class="bg-blue-400 transition-all duration-300" style="width: 25%" title="Tenaga Kerja"></div>
                                <div id="barOverhead" class="bg-purple-400 transition-all duration-300" style="width: 25%" title="Overhead"></div>
                            </div>
                            <div class="grid grid-cols-3 gap-1 text-[11px] pt-1">
                                <div class="flex items-center gap-1.5">
                                    <span class="w-2 h-2 rounded-full bg-teal-400"></span>
                                    <span class="text-slate-300">Bahan: <strong id="pctRawMaterial">0%</strong></span>
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <span class="w-2 h-2 rounded-full bg-blue-400"></span>
                                    <span class="text-slate-300">TK: <strong id="pctLabor">0%</strong></span>
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <span class="w-2 h-2 rounded-full bg-purple-400"></span>
                                    <span class="text-slate-300">BOP: <strong id="pctOverhead">0%</strong></span>
                                </div>
                            </div>
                        </div>

                        <!-- Financial Projections Details -->
                        <div class="border-t border-slate-700/80 pt-4 space-y-2 text-xs">
                            <div class="flex justify-between text-slate-300">
                                <span>Target Output Batch:</span>
                                <span class="font-semibold text-white" id="resBatchUnits">100 Unit</span>
                            </div>
                            <div class="flex justify-between text-slate-300">
                                <span>Potensi Total Omset (Revenue):</span>
                                <span class="font-semibold text-emerald-300" id="resTotalRevenue">Rp 0</span>
                            </div>
                            <div class="flex justify-between text-slate-300">
                                <span>Potensi Total Laba Bersih:</span>
                                <span class="font-bold text-white text-sm" id="resTotalProfit">Rp 0</span>
                            </div>
                            <div class="flex justify-between text-slate-300">
                                <span>Net Profit Margin:</span>
                                <span class="font-semibold text-emerald-400" id="resMarginPercent">0%</span>
                            </div>
                        </div>

                        <!-- Break-Even Point (BEP) Card -->
                        <div class="mt-5 bg-slate-800/90 rounded-xl p-3.5 border border-slate-700">
                            <div class="text-xs font-semibold text-amber-300 flex items-center gap-1.5 mb-2">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>
                                Analisis Titik Impas (Break-Even Point)
                            </div>
                            <div class="grid grid-cols-2 gap-2 text-xs">
                                <div>
                                    <span class="text-slate-400 text-[11px]">BEP Unit (Minimal Terjual):</span>
                                    <div class="font-bold text-white text-sm mt-0.5" id="resBepUnits">0 Unit</div>
                                </div>
                                <div>
                                    <span class="text-slate-400 text-[11px]">BEP Rupiah (Omset Balik Modal):</span>
                                    <div class="font-bold text-white text-sm mt-0.5" id="resBepRevenue">Rp 0</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Summary Details Table for Print & Export -->
